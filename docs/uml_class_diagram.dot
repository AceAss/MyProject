digraph BusBookingV2 {
  graph [rankdir=TB, splines=ortho, nodesep=0.5, ranksep=0.9, fontname="Helvetica", bgcolor="white"];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, penwidth=1.2];

  subgraph cluster_app {
    label="com.busbooking.app"; style="rounded,filled"; fillcolor="#faf5ff40"; color="#7e22ce"; fontcolor="#7e22ce"; fontsize=13;
  "Main" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#faf5ff" COLOR="#7e22ce"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Main</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="3">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>+ main(args: String[]): void</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- openService(): BookingService</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- bookTicket(): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- cancelTicket(): void</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#7e22ce", fillcolor="#faf5ff"];
  "AdminMenu" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#faf5ff" COLOR="#7e22ce"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">AdminMenu</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>- ADMIN_PASSWORD: String</U></FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ run(): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- addBus(): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- cancelTrip(): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- resetData(): void</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#7e22ce", fillcolor="#faf5ff"];
  }

  subgraph cluster_service {
    label="com.busbooking.service"; style="rounded,filled"; fillcolor="#f0fdf440"; color="#15803d"; fontcolor="#15803d"; fontsize=13;
  "BookingService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f0fdf4" COLOR="#15803d"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">BookingService</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- buses[], trips[], bookings[]: array</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- people[], coupons[]: array</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- clock: Clock   {transient}</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ reserve(trip,pax,seats[],coupon): Booking</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ reserve(trip,pax,count): Booking</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ generateSchedule(days): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ cancelBooking(booking): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ cancelTrip(trip): Booking[]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ resetToSampleData(): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ afterLoad(clock): void</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#15803d", fillcolor="#f0fdf4"];
  "FareCalculator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f0fdf4" COLOR="#15803d"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;utility, final&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">FareCalculator</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="3">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>+ breakdown(fare,seats,Discountable): FareBreakdown</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ breakdown(fare,seats,Disc,Disc): FareBreakdown</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ refundAmount(paid,RefundTier): double</U></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#15803d", fillcolor="#f0fdf4"];
  "DataStore" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f0fdf4" COLOR="#15803d"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">DataStore</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- dataFile: Path</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- ticketDir: Path</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ save(service): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ load(clock): BookingService</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ exportTicket(booking): Path</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#15803d", fillcolor="#f0fdf4"];
  }

  subgraph cluster_util {
    label="com.busbooking.util   (used from app, service and model as needed)"; style="rounded,filled"; fillcolor="#f8fafc"; color="#475569"; fontsize=12; fontcolor="#475569";
  "DateFmt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc" COLOR="#475569"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;utility, final&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">DateFmt</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="3">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>+ parseDate(text): LocalDate</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ parseTime(text): LocalTime</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ dateTime(ldt): String</U></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#475569", fillcolor="#f8fafc"];
  "InputHelper" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc" COLOR="#475569"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;utility, final&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">InputHelper</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="3">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>+ readInt(prompt,min,max): int</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ readYesNo(prompt): boolean</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ parseSeatList(text): int[]</U></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#475569", fillcolor="#f8fafc"];
  }

  subgraph cluster_iface {
    label="com.busbooking.model  (interfaces)"; style="rounded,filled"; fillcolor="#e6f4f140"; color="#0f766e"; fontcolor="#0f766e"; fontsize=13;
  "Payable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e6f4f1" COLOR="#0f766e"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;interface&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Payable</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="3">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><I>+ getPayableAmount(): double</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><I>+ pay(amountTendered): void</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><I>+ isPaid(): boolean</I></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#0f766e", fillcolor="#e6f4f1"];
  "Discountable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e6f4f1" COLOR="#0f766e"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;interface&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Discountable</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="3">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><I>+ getDiscountRate(): double</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><I>+ applyDiscount(amount): double</I></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#0f766e", fillcolor="#e6f4f1"];
  }

  subgraph cluster_person {
    label="com.busbooking.model  (people)"; style="rounded,filled"; fillcolor="#eef2ff40"; color="#4338ca"; fontcolor="#4338ca"; fontsize=13;
  "Person" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eef2ff" COLOR="#4338ca"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Person</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- name, phone: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- age: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>- totalPeople: int</U></FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ describe(): String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ getTotalPeople(): int</U></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#4338ca", fillcolor="#eef2ff"];
  "Passenger" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eef2ff" COLOR="#4338ca"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Passenger</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- passengerId: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- isStudent: boolean</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ getDiscountRate(): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ applyDiscount(amount): double</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#4338ca", fillcolor="#eef2ff"];
  "Driver" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eef2ff" COLOR="#4338ca"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Driver</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- licenceNumber: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- experienceYears: int</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#4338ca", fillcolor="#eef2ff"];
  }

  subgraph cluster_bus {
    label="com.busbooking.model  (vehicle)"; style="rounded,filled"; fillcolor="#fff7ed40"; color="#c2410c"; fontcolor="#c2410c"; fontsize=13;
  "Bus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14"><I>Bus</I></FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>+ DEFAULT_SEATS: int</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- busNumber: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- type: BusType</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- route: Route</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- departureTime, driver, totalSeats</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>- totalBuses: int</U></FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><I>+ calculateFare(): double</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><I>+ getAmenities(): String</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11"><U>+ getTotalBuses(): int</U></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#c2410c", fillcolor="#fff7ed"];
  "OrdinaryBus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">OrdinaryBus</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="3">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ calculateFare(): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ getAmenities(): String</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#c2410c", fillcolor="#fff7ed"];
  "AcBus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">AcBus</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>- AC_SURCHARGE: double</U></FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ calculateFare(): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ getAmenities(): String</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#c2410c", fillcolor="#fff7ed"];
  "SleeperBus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">SleeperBus</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>- BERTH_CHARGE: double</U></FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ calculateFare(): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ getAmenities(): String</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#c2410c", fillcolor="#fff7ed"];
  "Route" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff7ed" COLOR="#c2410c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Route</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- source, destination: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- distanceKm: int</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#c2410c", fillcolor="#fff7ed"];
  }

  subgraph cluster_trip {
    label="com.busbooking.model  (trip &amp; booking)"; style="rounded,filled"; fillcolor="#f0f9ff40"; color="#0369a1"; fontcolor="#0369a1"; fontsize=13;
  "Trip" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f0f9ff" COLOR="#0369a1"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Trip</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>+ BY_DEPARTURE, BY_FARE: Comparator</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- tripId: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- bus: Bus</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- departure: LocalDateTime</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- seatBooked[]: boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- status: TripStatus</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ bookSeat(seatNo): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ bookSeat(): int   //overload</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ ensureOpen(now): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ cancel(): void</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#0369a1", fillcolor="#f0f9ff"];
  "Booking" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f0f9ff" COLOR="#0369a1"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Booking</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- pnr: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- passenger: Passenger</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- trip: Trip</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- seatNumbers[]: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- fare: FareBreakdown</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- couponCode, status, refundAmount</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ pay(amountTendered): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ getTicketText(): String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ markCancelled(refund): void</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ markTripCancelled(refund): void</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#0369a1", fillcolor="#f0f9ff"];
  "Coupon" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f0f9ff" COLOR="#0369a1"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Coupon</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11"><U>+ NONE: Coupon</U></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- code, rate: String,double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- maxDiscount, validUntil</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+ applyDiscount(amount): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">+ validateOn(today): void</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#0369a1", fillcolor="#f0f9ff"];
  "FareBreakdown" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f0f9ff" COLOR="#0369a1"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;final, immutable&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">FareBreakdown</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- farePerSeat: double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- seats: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- concessionAmount, couponAmount</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">- gst, total: double</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#0369a1", fillcolor="#f0f9ff"];
  }

  subgraph cluster_enum {
    label="com.busbooking.model  (enums)"; style="rounded,filled"; fillcolor="#fefce840"; color="#a16207"; fontcolor="#a16207"; fontsize=13;
  "BusType" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fefce8" COLOR="#a16207"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">BusType</FONT></B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">ORDINARY<BR ALIGN="CENTER"/>AC_SEATER<BR ALIGN="CENTER"/>AC_SLEEPER<BR ALIGN="CENTER"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">- ratePerKm, label</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#a16207", fillcolor="#fefce8"];
  "BookingStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fefce8" COLOR="#a16207"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">BookingStatus</FONT></B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">CONFIRMED<BR ALIGN="CENTER"/>CANCELLED<BR ALIGN="CENTER"/>TRIP_CANCELLED<BR ALIGN="CENTER"/></FONT></TD></TR></TABLE>>, color="#a16207", fillcolor="#fefce8"];
  "TripStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fefce8" COLOR="#a16207"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">TripStatus</FONT></B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">SCHEDULED<BR ALIGN="CENTER"/>CANCELLED<BR ALIGN="CENTER"/></FONT></TD></TR></TABLE>>, color="#a16207", fillcolor="#fefce8"];
  "RefundTier" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fefce8" COLOR="#a16207"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">RefundTier</FONT></B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">EARLY   90%  &gt;=48h<BR ALIGN="CENTER"/>STANDARD 75%  12-48h<BR ALIGN="CENTER"/>LATE    50%  2-12h<BR ALIGN="CENTER"/>NONE     0%  &lt;2h<BR ALIGN="CENTER"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10"><U>+ forMinutesLeft(mins): RefundTier</U></FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#a16207", fillcolor="#fefce8"];
  }

  subgraph cluster_exc {
    label="com.busbooking.exception"; style="rounded,filled"; fillcolor="#fef2f240"; color="#b91c1c"; fontcolor="#b91c1c"; fontsize=13;
  "Exception" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef2f2" COLOR="#b91c1c"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">&laquo;java.lang&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">Exception</FONT></B></TD></TR></TABLE>>, color="#b91c1c", fillcolor="#fef2f2"];
  "BookingException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef2f2" COLOR="#b91c1c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">BookingException</FONT></B></TD></TR></TABLE>>, color="#b91c1c", fillcolor="#fef2f2"];
  "SeatUnavailableException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef2f2" COLOR="#b91c1c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">SeatUnavailableException</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- seatNo: int</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#b91c1c", fillcolor="#fef2f2"];
  "PaymentFailedException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef2f2" COLOR="#b91c1c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">PaymentFailedException</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- amountDue, amountTendered</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#b91c1c", fillcolor="#fef2f2"];
  "InvalidCouponException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef2f2" COLOR="#b91c1c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">InvalidCouponException</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- code: String</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#b91c1c", fillcolor="#fef2f2"];
  "TripClosedException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef2f2" COLOR="#b91c1c"><TR><TD ALIGN="CENTER"><B><FONT POINT-SIZE="14">TripClosedException</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">- tripId: String</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>, color="#b91c1c", fillcolor="#fef2f2"];
  }

  "Passenger" -> "Person" [arrowhead=empty, penwidth=1.3];
  "Driver" -> "Person" [arrowhead=empty, penwidth=1.3];
  "OrdinaryBus" -> "Bus" [arrowhead=empty, penwidth=1.3];
  "AcBus" -> "Bus" [arrowhead=empty, penwidth=1.3];
  "SleeperBus" -> "Bus" [arrowhead=empty, penwidth=1.3];
  "BookingException" -> "Exception" [arrowhead=empty, penwidth=1.3];
  "SeatUnavailableException" -> "BookingException" [arrowhead=empty, penwidth=1.3];
  "PaymentFailedException" -> "BookingException" [arrowhead=empty, penwidth=1.3];
  "InvalidCouponException" -> "BookingException" [arrowhead=empty, penwidth=1.3];
  "TripClosedException" -> "BookingException" [arrowhead=empty, penwidth=1.3];
  "Passenger" -> "Discountable" [arrowhead=empty, style=dashed];
  "Coupon" -> "Discountable" [arrowhead=empty, style=dashed];
  "Booking" -> "Payable" [arrowhead=empty, style=dashed];
  "Bus" -> "Route" [dir=back, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="1"];
  "Bus" -> "Driver" [dir=back, arrowtail=odiamond, arrowhead=none, taillabel="*", headlabel="1"];
  "Trip" -> "Bus" [dir=back, arrowtail=odiamond, arrowhead=none, taillabel="*", headlabel="1"];
  "Booking" -> "Trip" [dir=back, arrowtail=odiamond, arrowhead=none, taillabel="*", headlabel="1"];
  "Booking" -> "Passenger" [dir=back, arrowtail=odiamond, arrowhead=none, taillabel="*", headlabel="1"];
  "Booking" -> "FareBreakdown" [dir=back, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1"];
  "BookingService" -> "Trip" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "BookingService" -> "Booking" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "BookingService" -> "Coupon" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "BookingService" -> "FareCalculator" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "FareCalculator" -> "RefundTier" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "FareCalculator" -> "Discountable" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "DataStore" -> "BookingService" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "Trip" -> "RefundTier" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "Trip" -> "TripStatus" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "Booking" -> "BookingStatus" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "Bus" -> "BusType" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "Main" -> "BookingService" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "Main" -> "DataStore" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "AdminMenu" -> "BookingService" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "AdminMenu" -> "DataStore" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9];
  "BookingService" -> "BookingException" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9, constraint=false];
  "Trip" -> "SeatUnavailableException" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9, constraint=false];
  "Trip" -> "TripClosedException" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9, constraint=false];
  "Booking" -> "PaymentFailedException" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9, constraint=false];
  "Coupon" -> "InvalidCouponException" [style=dashed, arrowhead=vee, color="#94a3b8", penwidth=0.9, constraint=false];

  subgraph cluster_legend {
    label="Legend"; style="rounded,filled"; fillcolor="white"; color="#334155"; fontsize=13; fontname="Helvetica";
    legend [shape=plain, label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">&#8213;&#8213;&#9651;&#160;&#160;inheritance (extends)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">- - -&#9651;&#160;&#160;interface realization (implements)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">&#9671;&#8213;&#8213;&#160;&#160;aggregation (has-a, part can outlive whole)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">&#9670;&#8213;&#8213;&#160;&#160;composition (owns exclusively, e.g. Booking&#8217;s FareBreakdown)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">- - -&#8594;&#160;&#160;dependency (uses / creates / throws)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">+ public &#160;&#160;- private &#160;&#160;<I>italic</I> = abstract &#160;&#160;<U>underline</U> = static</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">(Serializable, implemented by every persisted class, is omitted for clarity)</FONT></TD></TR>
      </TABLE>
    >];
  }
}
